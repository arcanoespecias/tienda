{
  "code": 200,
  "data": {
    "description": "",
    "external": {
      "apple-touch-icon": {
        "https://arcanoespecias.github.io/arcano-v2/icons/icon-192.png": {}
      },
      "icon": {
        "https://arcanoespecias.github.io/arcano-v2/icons/favicon.png": {
          "type": "image/png"
        }
      },
      "manifest": {
        "https://arcanoespecias.github.io/arcano-v2/manifest.json": {}
      }
    },
    "html": "<html lang=\"es\" style=\"--bg: #1b0b07; --bg2: #221108; --surface: #2a150e; --surface2: #331e12; --gold: #c9963a; --gold2: #e8b84b; --cream: #f0e8d0; --muted: #7a6a50; --fs-base: 15px; --fs-title: 1.9rem;\"><head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n<meta http-equiv=\"Pragma\" content=\"no-cache\">\n<meta http-equiv=\"Expires\" content=\"0\">\n<meta name=\"theme-color\" content=\"#1b0b07\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Arcano\">\n<link rel=\"icon\" type=\"image/png\" href=\"icons/favicon.png\">\n<link rel=\"apple-touch-icon\" href=\"icons/icon-192.png\">\n<title>Arcano — Complice del Sabor</title>\n<link rel=\"manifest\" href=\"manifest.json\">\n<link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body style=\"background: rgb(27, 11, 7); font-size: 15px;\">\n\n<!-- PIN SCREEN -->\n<div id=\"pin-screen\" style=\"display:flex\">\n      <img src=\"icons/logo-pin.png?v=9\" style=\"width:80px;height:80px;margin-bottom:4px;object-fit:contain\">\n      <div class=\"pin-logo\">Arcano</div>\n      <div class=\"pin-sub\">Complice del Sabor</div>\n      <div class=\"user-list\" style=\"margin-top:8px\">\n        \n          <button class=\"user-btn\" onclick=\"selectUser(1)\">\n            <div class=\"user-avatar\">👑</div>\n            <div>\n              <div style=\"font-size:.95rem;font-weight:700\">Admin</div>\n              <div style=\"font-size:.7rem;color:var(--muted)\">admin</div>\n            </div>\n          </button>\n          <button class=\"user-btn\" onclick=\"selectUser(2)\">\n            <div class=\"user-avatar\">🌿</div>\n            <div>\n              <div style=\"font-size:.95rem;font-weight:700\">Operador</div>\n              <div style=\"font-size:.7rem;color:var(--muted)\">operador</div>\n            </div>\n          </button>\n      </div></div>\n\n<!-- PWA INSTALL BANNER -->\n<div id=\"pwa-banner\" style=\"display:none\">\n  <div class=\"pwa-banner-inner\">\n    <img src=\"icons/icon-192.png\" alt=\"\" style=\"width:40px;height:40px;border-radius:8px\">\n    <div class=\"pwa-banner-text\">\n      <div class=\"fw7 text-sm\">Instalar Arcano</div>\n      <div class=\"text-xs text-muted\">Acceso rapido desde tu pantalla de inicio</div>\n    </div>\n    <button class=\"btn btn-gold btn-sm\" id=\"pwa-install-btn\" onclick=\"installPWA()\">Instalar</button>\n    <button class=\"btn btn-ghost btn-sm\" onclick=\"dismissPWA()\" style=\"padding:5px 8px;font-size:.9rem\">x</button>\n  </div>\n</div>\n\n<!-- TOAST -->\n<div id=\"toast\"></div>\n\n<!-- HEADER -->\n<div id=\"app-header\">\n  <div class=\"header-logo\">\n    <img src=\"icons/logo-header.png\" alt=\"Arcano\" style=\"width:34px;height:34px;border-radius:50%;object-fit:cover\">\n    <div>\n      <div class=\"header-brand\">Arcano</div>\n      <div class=\"header-sub\">Gestion de especias y blends para Arcano</div>\n    </div>\n  </div>\n  <div class=\"header-pin\">\n    <div id=\"sync-indicator\" onclick=\"forceSyncNow()\" title=\"Click para forzar sync\" style=\"cursor:pointer;font-size:.7rem;margin-right:8px;display:flex;align-items:center;gap:4px\">\n      <span id=\"sync-dot\" style=\"width:8px;height:8px;border-radius:50%;background:#666;display:inline-block\"></span>\n      <span id=\"sync-text\" style=\"color:var(--muted);font-size:.6rem\">—</span>\n    </div>\n    <div class=\"user-chip\" id=\"user-chip\" onclick=\"logoutUser()\">— Salir</div>\n  </div>\n</div>\n\n<!-- NAV -->\n<nav id=\"app-nav\">\n  <button class=\"nav-btn active\" onclick=\"goPage('dashboard',this)\">Dashboard</button>\n  <button class=\"nav-btn\" onclick=\"goPage('costos',this)\">Costos</button>\n  <button class=\"nav-btn\" onclick=\"goPage('especias',this)\">Especias</button>\n  <button class=\"nav-btn\" onclick=\"goPage('blends',this)\">Blends</button>\n  <button class=\"nav-btn\" onclick=\"goPage('envases',this)\">Envases</button>\n  <button class=\"nav-btn\" onclick=\"goPage('ventas',this)\">Ventas</button>\n  <button class=\"nav-btn\" onclick=\"goPage('reportes',this)\">Reportes</button>\n  <button class=\"nav-btn\" id=\"nav-ajustes\" onclick=\"goPage('ajustes',this)\">⚙ Ajustes</button>\n</nav>\n\n<main>\n\n<!-- DASHBOARD -->\n<div id=\"page-dashboard\" class=\"page active\">\n  <div class=\"page-title\">Dashboard</div>\n  <div class=\"g4 mb-20\" id=\"dash-stats\"></div>\n  <div class=\"g2 mb-20\">\n    <div class=\"card\">\n      <h3>Ventas ultimos 7 dias</h3>\n      <div class=\"bar-chart\" id=\"chart-7d\"></div>\n    </div>\n    <div class=\"card\">\n      <h3>Stock bajo — alerta</h3>\n      <div id=\"dash-stock-bajo\"></div>\n    </div>\n  </div>\n  <div class=\"g2\">\n    <div class=\"card\">\n      <h3>Ultimas ventas</h3>\n      <div class=\"tw\"><table>\n        <thead><tr><th>Fecha</th><th>Productos</th><th>Total</th><th>Estado</th></tr></thead>\n        <tbody id=\"dash-ventas-tabla\"></tbody>\n      </table></div>\n    </div>\n    <div class=\"card\">\n      <h3>Productos mas vendidos</h3>\n      <div id=\"dash-top\"></div>\n    </div>\n  </div>\n</div>\n\n<!-- COSTOS -->\n<div id=\"page-costos\" class=\"page\">\n  <div class=\"page-title\">Costos</div>\n  <div class=\"g2 mb-20\">\n    <div class=\"card\">\n      <h3>Envases</h3>\n      <div class=\"fr\">\n        <div><label>Envase Chico ($/u)</label><input type=\"number\" id=\"c-env-c\" oninput=\"saveCostos()\"></div>\n        <div><label>Envase Grande ($/u)</label><input type=\"number\" id=\"c-env-g\" oninput=\"saveCostos()\"></div>\n      </div>\n    </div>\n    <div class=\"card\">\n      <h3>Packaging</h3>\n      <div class=\"fr\">\n        <div><label>Packaging Chico</label><input type=\"number\" id=\"c-pkg-c\" oninput=\"saveCostos()\"></div>\n        <div><label>Packaging Grande</label><input type=\"number\" id=\"c-pkg-g\" oninput=\"saveCostos()\"></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"card mb-20\">\n    <h3>Otros costos fijos por unidad</h3>\n    <div class=\"fr3\">\n      <div><label>Etiqueta</label><input type=\"number\" id=\"c-etiq\" oninput=\"saveCostos()\"></div>\n      <div><label>Mano de obra</label><input type=\"number\" id=\"c-mo\" oninput=\"saveCostos()\"></div>\n      <div><label>Otros</label><input type=\"number\" id=\"c-otros\" oninput=\"saveCostos()\"></div>\n    </div>\n  </div>\n  <div class=\"card\">\n    <h3>Resumen de costos fijos por unidad</h3>\n    <div class=\"g2 mt-12\" id=\"resumen-costos\"></div>\n  </div>\n</div>\n\n<!-- ESPECIAS -->\n<div id=\"page-especias\" class=\"page\">\n  <div class=\"flex items-center justify-between mb-20\">\n    <div class=\"page-title\" style=\"margin:0\">Especias</div>\n    <button class=\"btn btn-gold\" onclick=\"openModalEspecia()\">+ Nueva especia</button>\n  </div>\n  <div class=\"search-wrap\">\n    <input id=\"search-esp\" placeholder=\"Buscar especia...\" oninput=\"renderEspecias()\">\n  </div>\n  <div class=\"card\">\n    <div class=\"tw\">\n      <table>\n        <thead><tr><th>Nombre</th><th>Precio/kg</th><th>Precio/100g</th><th>Stock</th><th>Minimo</th><th>Estado</th><th></th></tr></thead>\n        <tbody id=\"tabla-especias\"></tbody>\n      </table></div>\n    </div>\n</div>\n\n<!-- BLENDS -->\n<div id=\"page-blends\" class=\"page\">\n  <div class=\"flex items-center justify-between mb-20\">\n    <div class=\"page-title\" style=\"margin:0\">Blends</div>\n    <div class=\"flex gap-8\">\n      <button class=\"btn btn-ghost btn-sm\" id=\"btn-export-blends\" onclick=\"exportBlendsExcel()\" style=\"display:none\">📥 Exportar Excel</button>\n      <button class=\"btn btn-gold\" onclick=\"openModalBlend()\">+ Nuevo blend</button>\n    </div>\n  </div>\n  <div id=\"lista-blends\"></div>\n</div>\n\n<!-- ENVASES -->\n<div id=\"page-envases\" class=\"page\">\n  <div class=\"flex items-center justify-between mb-20\">\n    <div class=\"page-title\" style=\"margin:0\">Envases</div>\n    <button class=\"btn btn-gold\" id=\"btn-new-envase\" onclick=\"openModalEnvase()\" style=\"display:none\">+ Nuevo envase</button>\n  </div>\n  <div id=\"lista-envases\"></div>\n</div>\n\n<!-- VENTAS -->\n<div id=\"page-ventas\" class=\"page\">\n  <div class=\"flex items-center justify-between mb-20\">\n    <div class=\"page-title\" style=\"margin:0\">Ventas</div>\n    <button class=\"btn btn-gold\" onclick=\"openModalVenta()\">+ Nueva venta</button>\n  </div>\n  <div class=\"flex gap-8 mb-16\" style=\"flex-wrap:wrap\">\n    <div class=\"search-wrap\" style=\"flex:1;min-width:200px;margin-bottom:0\">\n      <input id=\"search-ventas\" placeholder=\"Buscar...\" oninput=\"renderVentas()\">\n    </div>\n    <select id=\"filter-estado\" onchange=\"renderVentas()\" style=\"width:auto\">\n      <option value=\"\">Todos los estados</option>\n      <option value=\"completada\">Completada</option>\n      <option value=\"pendiente\">Pendiente</option>\n      <option value=\"cancelada\">Cancelada</option>\n      <option value=\"entregada\">Entregada</option>\n    </select>\n  </div>\n  <div class=\"card\">\n    <div class=\"tw\">\n      <table>\n        <thead><tr><th>Fecha</th><th>Productos</th><th>Subtotal</th><th>Desc.</th><th>Total</th><th>Estado</th><th></th></tr></thead>\n        <tbody id=\"tabla-ventas\"></tbody>\n      </table></div>\n    </div>\n  </div>\n\n\n<!-- REPORTES -->\n<div id=\"page-reportes\" class=\"page\">\n  <div class=\"page-title\">Reportes</div>\n  <div class=\"g3 mb-20\" id=\"rep-stats\"></div>\n  <div class=\"tabs\">\n    <button class=\"tab active\" onclick=\"showTab('rep-mes')\">Por mes</button>\n    <button class=\"tab\" onclick=\"showTab('rep-prod')\">Por producto</button>\n    <button class=\"tab\" onclick=\"showTab('rep-rent')\">Rentabilidad</button>\n  </div>\n  <div id=\"rep-mes\" class=\"card\">\n    <h3>Ventas por mes</h3>\n    <div class=\"tw\"><table>\n      <thead><tr><th>Mes</th><th>Ventas</th><th>Ingresos</th><th>Prom./venta</th></tr></thead>\n      <tbody id=\"rep-mes-tabla\"></tbody>\n    </table></div>\n  </div>\n  <div id=\"rep-prod\" class=\"card\" style=\"display:none\">\n    <h3>Rendimiento por producto</h3>\n    <div class=\"tw\"><table>\n      <thead><tr><th>Producto</th><th>Unidades</th><th>Ingresos</th><th>% del total</th></tr></thead>\n      <tbody id=\"rep-prod-tabla\"></tbody>\n    </table></div>\n  </div>\n  <div id=\"rep-rent\" class=\"card\" style=\"display:none\">\n    <h3>Rentabilidad por blend</h3>\n    <div class=\"tw\"><table>\n      <thead><tr><th>Blend</th><th>Costo/kg</th><th>Unidad Chica</th><th>Unidad Grande</th></tr></thead>\n      <tbody id=\"rep-rent-tabla\"></tbody>\n    </table></div>\n  </div>\n</div>\n\n<!-- AJUSTES -->\n<div id=\"page-ajustes\" class=\"page\">\n  <div class=\"page-title\">Ajustes</div>\n\n  <!-- PWA CONFIG -->\n  <div class=\"card mb-20\" id=\"pwa-config-card\">\n    <div class=\"flex items-center justify-between mb-16\">\n      <h3 style=\"margin:0\">Apariencia y PWA</h3>\n      <div class=\"flex gap-8\">\n        <span id=\"pwa-status-badge\" class=\"badge by\">—</span>\n        <button class=\"btn btn-gold btn-sm\" id=\"pwa-install-btn-settings\" onclick=\"installPWA()\" style=\"display:none\">Instalar app</button>\n      </div>\n    </div>\n\n    <!-- IDENTIDAD -->\n    <div class=\"section-title mb-12\">Identidad</div>\n    <div class=\"g2 mb-16\">\n      <div><label>Nombre de la app</label><input id=\"pwa-cfg-name\" placeholder=\"Arcano — Complice del Sabor\" oninput=\"previewPWA()\"></div>\n      <div><label>Nombre corto</label><input id=\"pwa-cfg-short\" placeholder=\"Arcano\" oninput=\"previewPWA()\"></div>\n    </div>\n    <div class=\"g2 mb-16\">\n      <div><label>Descripcion</label><input id=\"pwa-cfg-desc\" placeholder=\"Gestion de especias y blends\"></div>\n      <div><label>Orientacion</label>\n        <select id=\"pwa-cfg-orient\" onchange=\"previewPWA()\">\n          <option value=\"portrait-primary\">Vertical</option>\n          <option value=\"landscape-primary\">Horizontal</option>\n          <option value=\"any\">Libre</option>\n        </select>\n      </div>\n    </div>\n\n    <hr class=\"divider\">\n\n    <!-- COLORES -->\n    <div class=\"section-title mb-12\">Colores</div>\n    <div class=\"g2 mb-12\">\n      <div><label>Fondo principal</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-bg\" type=\"color\" value=\"#1b0b07\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-bg-text\" value=\"#1b0b07\" maxlength=\"7\" oninput=\"syncColorInput('bg')\" style=\"flex:1\"></div>\n      </div>\n      <div><label>Fondo header / nav</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-bg2\" type=\"color\" value=\"#221108\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-bg2-text\" value=\"#221108\" maxlength=\"7\" oninput=\"syncColorInput('bg2')\" style=\"flex:1\"></div>\n      </div>\n    </div>\n    <div class=\"g2 mb-12\">\n      <div><label>Superficie (tarjetas)</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-surface\" type=\"color\" value=\"#2a150e\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-surface-text\" value=\"#2a150e\" maxlength=\"7\" oninput=\"syncColorInput('surface')\" style=\"flex:1\"></div>\n      </div>\n      <div><label>Superficie 2 (inputs)</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-surface2\" type=\"color\" value=\"#331e12\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-surface2-text\" value=\"#331e12\" maxlength=\"7\" oninput=\"syncColorInput('surface2')\" style=\"flex:1\"></div>\n      </div>\n    </div>\n    <div class=\"g2 mb-12\">\n      <div><label>Color accent (dorado)</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-gold\" type=\"color\" value=\"#c9963a\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-gold-text\" value=\"#c9963a\" maxlength=\"7\" oninput=\"syncColorInput('gold')\" style=\"flex:1\"></div>\n      </div>\n      <div><label>Color accent claro</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-gold2\" type=\"color\" value=\"#e8b84b\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-gold2-text\" value=\"#e8b84b\" maxlength=\"7\" oninput=\"syncColorInput('gold2')\" style=\"flex:1\"></div>\n      </div>\n    </div>\n    <div class=\"g2 mb-16\">\n      <div><label>Texto principal</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-cream\" type=\"color\" value=\"#f0e8d0\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-cream-text\" value=\"#f0e8d0\" maxlength=\"7\" oninput=\"syncColorInput('cream')\" style=\"flex:1\"></div>\n      </div>\n      <div><label>Texto secundario</label>\n        <div class=\"flex gap-8\"><input id=\"pwa-cfg-muted\" type=\"color\" value=\"#7a6a50\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-muted-text\" value=\"#7a6a50\" maxlength=\"7\" oninput=\"syncColorInput('muted')\" style=\"flex:1\"></div>\n      </div>\n    </div>\n    <div class=\"mb-16\"><label>Color tema (barra del celular)</label>\n      <div class=\"flex gap-8\"><input id=\"pwa-cfg-theme\" type=\"color\" value=\"#1b0b07\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-theme-text\" value=\"#1b0b07\" maxlength=\"7\" oninput=\"syncColorInput('theme')\" style=\"flex:1\"></div>\n    </div>\n\n    <hr class=\"divider\">\n\n    <!-- TIPOGRAFIA -->\n    <div class=\"section-title mb-12\">Tipografia</div>\n    <div class=\"g2 mb-16\">\n      <div>\n        <label>Tamano fuente base <span id=\"pwa-cfg-fs-base-val\" class=\"text-gold\">15px</span></label>\n        <input id=\"pwa-cfg-fs-base\" type=\"range\" min=\"11\" max=\"20\" step=\"1\" value=\"15\" oninput=\"previewPWA()\">\n      </div>\n      <div>\n        <label>Tamano titulos <span id=\"pwa-cfg-fs-title-val\" class=\"text-gold\">1.9rem</span></label>\n        <input id=\"pwa-cfg-fs-title\" type=\"range\" min=\"1.0\" max=\"3.0\" step=\"0.1\" value=\"1.9\" oninput=\"previewPWA()\">\n      </div>\n    </div>\n\n    <hr class=\"divider\">\n\n    <!-- VISTA PREVIA + BOTONES -->\n    <div class=\"cost-box mb-16\" id=\"pwa-preview-box\">\n      <div class=\"text-xs text-muted mb-12\">Vista previa</div>\n      <div class=\"flex items-center gap-8\">\n        <img src=\"icons/icon-192.png?v=13\" style=\"width:36px;height:36px;border-radius:8px\">\n        <div>\n          <div class=\"fw7 text-sm\" id=\"pwa-preview-name\">Arcano</div>\n          <div class=\"text-xs text-muted\" id=\"pwa-preview-desc\">Complice del Sabor</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"flex gap-8\">\n      <button class=\"btn btn-gold\" style=\"flex:1\" onclick=\"guardarPWAConfig()\">Guardar configuracion</button>\n      <button class=\"btn btn-ghost\" style=\"flex:1\" onclick=\"resetPWAConfig()\">Restaurar valores</button>\n    </div>\n  </div>\n\n  <div class=\"g2\">\n    <div class=\"card\">\n      <div class=\"flex items-center justify-between mb-16\">\n        <h3 style=\"margin:0\">Usuarios</h3>\n        <button class=\"btn btn-gold btn-sm\" onclick=\"openModalUsuario()\">+ Nuevo</button>\n      </div>\n      <div id=\"ajustes-usuarios\"></div>\n    </div>\n    <div>\n      <div class=\"card mb-16\">\n        <div class=\"flex items-center justify-between mb-16\">\n          <h3 style=\"margin:0\">Sincronizacion GitHub</h3>\n          <span id=\"gh-status-badge\" class=\"badge br\">Desconectado</span>\n        </div>\n        <p class=\"text-muted text-sm mb-16\">Los datos se guardan en un archivo JSON del repositorio. Los cambios se sincronizan automaticamente entre usuarios.</p>\n        <div id=\"gh-config-form\" style=\"display: block;\">\n          <div class=\"fr fr1\"><div><label>Personal Access Token</label><input id=\"gh-token\" type=\"password\" placeholder=\"ghp_xxxx...\"></div></div>\n          <div class=\"flex gap-8 mt-16\">\n            <button class=\"btn btn-gold\" style=\"flex:1\" onclick=\"guardarGhConfigUI()\">Conectar</button>\n          </div>\n          <div id=\"gh-test-result\" class=\"mt-12\" style=\"font-size:.82rem;min-height:20px\"></div>\n        </div>\n        <div id=\"gh-connected-info\" style=\"display:none\">\n          <div class=\"cost-box mb-16\">\n            <div class=\"cost-row\"><span>Repositorio</span><span id=\"gh-info-repo\" class=\"text-gold fw7\"></span></div>\n            <div class=\"cost-row\"><span>Branch</span><span id=\"gh-info-branch\"></span></div>\n            <div class=\"cost-row\"><span>Estado</span><span class=\"text-green fw7\">Sincronizando</span></div>\n          </div>\n          <div class=\"cost-box mb-16\" style=\"border-color:var(--gold-dim)\">\n            <p class=\"text-sm text-muted mb-12\" style=\"margin:0\">Comparti este link con otros usuarios para que se conecten automaticamente sin configurar nada:</p>\n            <div class=\"flex gap-8 mt-8\">\n              <input id=\"gh-share-link\" readonly=\"\" style=\"font-size:.75rem;opacity:.7\" onclick=\"this.select()\">\n              <button class=\"btn btn-gold btn-sm\" onclick=\"copiarLinkConexion()\">Copiar</button>\n            </div>\n          </div>\n          <div class=\"flex gap-8\">\n            <button class=\"btn btn-ghost\" style=\"flex:1\" onclick=\"forzarSyncManual()\">Forzar sincronizacion</button>\n            <button class=\"btn btn-red\" onclick=\"desconectarGh()\">Desconectar</button>\n          </div>\n          <div style=\"margin-top:12px\">\n            <button class=\"btn btn-gold btn-full\" onclick=\"forceReloadAllDevices()\" style=\"background:linear-gradient(135deg,#2a7a3a,#4caf50)\">Forzar actualizacion en todos los dispositivos</button>\n            <p class=\"text-muted text-xs mt-8\" style=\"margin:0\">Borra cache y recarga la app en todos los celulares/tablets conectados.</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"card\">\n        <h3>Zona de peligro</h3>\n        <p class=\"text-muted text-sm mb-16\">Borra todos los datos localmente.</p>\n        <button class=\"btn btn-red\" onclick=\"borrarTodo()\">Borrar todo</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n</main>\n\n<!-- MODAL ESPECIA -->\n<div class=\"modal-overlay\" id=\"modal-esp\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\" id=\"modal-esp-titulo\">Nueva especia</span>\n      <button class=\"modal-close\" onclick=\"closeModal('modal-esp')\">x</button>\n    </div>\n    <div id=\"alert-esp\" class=\"alert\"></div>\n    <div class=\"fr fr1\"><div><label>Nombre *</label><input id=\"esp-nombre\" placeholder=\"Ej: Comino\"></div></div>\n    <div class=\"fr\">\n      <div><label>Precio por kg ($) *</label><input id=\"esp-precio\" type=\"number\" min=\"0\" oninput=\"calcEsp100()\"></div>\n      <div><label>Precio por 100g</label><input id=\"esp-100\" readonly=\"\"></div>\n    </div>\n    <div class=\"fr\">\n      <div><label>Stock actual (g)</label><input id=\"esp-stock\" type=\"number\" min=\"0\" value=\"0\"></div>\n      <div><label>Stock minimo (g)</label><input id=\"esp-stockmin\" type=\"number\" min=\"0\" value=\"500\"></div>\n    </div>\n    <button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarEspecia()\">Guardar</button>\n  </div>\n</div>\n\n<!-- MODAL STOCK -->\n<div class=\"modal-overlay\" id=\"modal-stock\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\" id=\"ms-nombre\">Stock</span>\n      <button class=\"modal-close\" onclick=\"closeModal('modal-stock')\">x</button>\n    </div>\n    <div id=\"alert-stock\" class=\"alert\"></div>\n    <input type=\"hidden\" id=\"ms-esp-id\">\n    <div class=\"cost-box mb-16\">\n      <div class=\"cost-row\"><span>Stock actual</span><span class=\"fw7 text-gold\" id=\"ms-stock-actual\">—</span></div>\n    </div>\n    <div class=\"fr\">\n      <div>\n        <label>Tipo</label>\n        <select id=\"ms-tipo\">\n          <option value=\"entrada\">Entrada (compra)</option>\n          <option value=\"salida\">Salida (uso/merma)</option>\n        </select>\n      </div>\n      <div><label>Cantidad (gramos)</label><input id=\"ms-cantidad\" type=\"number\" min=\"0\" placeholder=\"0\"></div>\n    </div>\n    <div class=\"fr fr1\"><div><label>Nota (opcional)</label><input id=\"ms-nota-stock\" placeholder=\"Ej: Compra proveedor X\"></div></div>\n    <button class=\"btn btn-gold btn-full mb-16\" onclick=\"guardarMovimiento()\">Registrar movimiento</button>\n    <h3>Ultimos movimientos</h3>\n    <div id=\"ms-historial\"></div>\n  </div>\n</div>\n\n<!-- MODAL BLEND -->\n<div class=\"modal-overlay\" id=\"modal-blend\">\n  <div class=\"modal\" style=\"max-width:620px\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\" id=\"modal-blend-titulo\">Nuevo Blend</span>\n      <button class=\"modal-close\" onclick=\"closeModal('modal-blend')\">x</button>\n    </div>\n    <div id=\"alert-blend\" class=\"alert\"></div>\n    <div class=\"fr fr1\"><div><label>Nombre *</label><input id=\"bl-nombre\" placeholder=\"Ej: Garam Masala\"></div></div>\n    <div class=\"fr\">\n      <div><label>Peso envase chico (g)</label><input id=\"bl-peso-c\" type=\"number\" min=\"0\" oninput=\"calcBlendModal()\"></div>\n      <div><label>Peso envase grande (g)</label><input id=\"bl-peso-g\" type=\"number\" min=\"0\" oninput=\"calcBlendModal()\"></div>\n    </div>\n    <div class=\"fr\">\n      <div><label>Precio venta chico ($)</label><input id=\"bl-pventa-c\" type=\"number\" min=\"0\"></div>\n      <div><label>Precio venta grande ($)</label><input id=\"bl-pventa-g\" type=\"number\" min=\"0\"></div>\n    </div>\n    <div class=\"fr fr1\"><div><label>Notas / instrucciones</label><textarea id=\"bl-notas\" placeholder=\"Ej: Mezclar en seco.\"></textarea></div></div>\n    <div class=\"divider\"></div>\n    <h3>Ingredientes — formula para 1kg</h3>\n    <div id=\"blend-ings-rows\"></div>\n    <button class=\"btn btn-ghost btn-sm mt-12\" onclick=\"addIngRow()\">+ Agregar especia</button>\n    <div class=\"cost-box mt-16\">\n      <div class=\"fr\" style=\"margin-bottom:0\">\n        <div>\n          <div class=\"cost-row\"><span>Costo blend /kg</span><span id=\"bc-kg\">$0</span></div>\n          <div class=\"cost-row\"><span>Costo blend /100g</span><span id=\"bc-100\">$0</span></div>\n          <div class=\"text-xs mt-12\" id=\"bc-grams\" style=\"text-align:center\"></div>\n        </div>\n        <div>\n          <div class=\"cost-row total\"><span>Total u. chica</span><span id=\"bc-tot-c\">$0</span></div>\n          <div class=\"cost-row text-xs\"><span class=\"text-muted\">MP chico</span><span id=\"bc-mp-c\">$0</span></div>\n          <div class=\"cost-row text-xs\"><span class=\"text-muted\">Fijos chico</span><span id=\"bc-fij-c\">$0</span></div>\n          <div class=\"cost-row total\" style=\"margin-top:8px\"><span>Total u. grande</span><span id=\"bc-tot-g\">$0</span></div>\n          <div class=\"cost-row text-xs\"><span class=\"text-muted\">MP grande</span><span id=\"bc-mp-g\">$0</span></div>\n          <div class=\"cost-row text-xs\"><span class=\"text-muted\">Fijos grande</span><span id=\"bc-fij-g\">$0</span></div>\n        </div>\n      </div>\n    </div>\n    <button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarBlend()\">Guardar blend</button>\n  </div>\n</div>\n\n<!-- MODAL VENTA -->\n<div class=\"modal-overlay\" id=\"modal-venta\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\" id=\"modal-venta-titulo\">Nueva venta</span>\n      <button class=\"modal-close\" onclick=\"closeModal('modal-venta')\">x</button>\n    </div>\n    <div id=\"alert-venta\" class=\"alert\"></div>\n    <div class=\"mb-16\">\n      <label>Agregar producto</label>\n      <div class=\"flex gap-8 mb-12\">\n        <select id=\"v-prod-sel\" style=\"flex:1\"></select>\n        <input id=\"v-qty\" type=\"number\" min=\"1\" value=\"1\" style=\"width:65px\">\n        <button class=\"btn btn-ghost btn-sm\" onclick=\"agregarItemVenta()\">+ Add</button>\n      </div>\n      <div id=\"v-items-lista\" style=\"background:var(--surface2);border-radius:8px;padding:10px;min-height:48px\"></div>\n    </div>\n    <div class=\"fr\">\n      <div><label>Descuento ($)</label><input id=\"v-desc\" type=\"number\" min=\"0\" value=\"0\" oninput=\"recalcVenta()\"></div>\n      <div style=\"display:flex;flex-direction:column;justify-content:flex-end\">\n        <label>Total</label>\n        <div class=\"fw7 text-gold\" style=\"font-size:1.3rem;padding:8px 0\" id=\"v-total\">$0</div>\n      </div>\n    </div>\n    <div class=\"fr\">\n      <div><label>Estado</label>\n        <select id=\"v-estado\">\n          <option value=\"completada\">Completada</option>\n          <option value=\"pendiente\">Pendiente</option>\n          <option value=\"entregada\">Entregada</option>\n          <option value=\"cancelada\">Cancelada</option>\n        </select>\n      </div>\n      <div><label>Nota</label><input id=\"v-nota\" placeholder=\"Ej: Pago en cuotas...\"></div>\n    </div>\n    <button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarVenta()\">Guardar venta</button>\n  </div>\n</div>\n\n<!-- MODAL USUARIO -->\n<div class=\"modal-overlay\" id=\"modal-usuario\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\" id=\"modal-usr-titulo\">Nuevo usuario</span>\n      <button class=\"modal-close\" onclick=\"closeModal('modal-usuario')\">x</button>\n    </div>\n    <div id=\"alert-usr\" class=\"alert\"></div>\n    <div class=\"fr\">\n      <div><label>Nombre *</label><input id=\"usr-nombre\" placeholder=\"Ej: Maria\"></div>\n      <div><label>Emoji / avatar</label><input id=\"usr-emoji\" placeholder=\"🌶\" maxlength=\"2\"></div>\n    </div>\n    <div class=\"fr\">\n      <div><label>PIN (min. 4 digitos) *</label><input id=\"usr-pin\" type=\"password\" maxlength=\"8\" placeholder=\"....\"></div>\n      <div><label>Rol</label>\n        <select id=\"usr-rol\">\n          <option value=\"admin\">Admin</option>\n          <option value=\"operador\">Operador</option>\n        </select>\n      </div>\n    </div>\n    <button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarUsuario()\">Guardar usuario</button>\n  </div>\n</div>\n\n<!-- MODAL ENVASE -->\n<div class=\"modal-overlay\" id=\"modal-env\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\" id=\"modal-env-titulo\">Nuevo envase</span>\n      <button class=\"modal-close\" onclick=\"closeModal('modal-env')\">x</button>\n    </div>\n    <div id=\"alert-env\" class=\"alert\"></div>\n    <div class=\"fr fr1\"><div><label>Nombre *</label><input id=\"env-nombre\" placeholder=\"Ej: Frasco 100ml\"></div></div>\n    <div class=\"fr\">\n      <div><label>Tipo</label><select id=\"env-tipo\"><option value=\"chico\">Pequeno</option><option value=\"grande\">Grande</option></select></div>\n      <div><label>Peso (g)</label><input id=\"env-peso\" type=\"number\" min=\"0\"></div>\n    </div>\n    <div class=\"fr\">\n      <div><label>Stock (unidades)</label><input id=\"env-stock\" type=\"number\" min=\"0\" value=\"0\"></div>\n      <div><label>Stock minimo</label><input id=\"env-stockmin\" type=\"number\" min=\"0\" value=\"20\"></div>\n    </div>\n    <div class=\"fr fr1\"><div><label>Precio ($/u)</label><input id=\"env-precio\" type=\"number\" min=\"0\" value=\"0\"></div></div>\n    <button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarEnvase()\">Guardar envase</button>\n  </div>\n</div>\n\n<!-- MODAL STOCK ENVASE -->\n<div class=\"modal-overlay\" id=\"modal-env-stock\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\" id=\"me-nombre\">Stock envase</span>\n      <button class=\"modal-close\" onclick=\"closeModal('modal-env-stock')\">x</button>\n    </div>\n    <div id=\"alert-env-stock\" class=\"alert\"></div>\n    <input type=\"hidden\" id=\"me-env-id\">\n    <div class=\"cost-box mb-16\">\n      <div class=\"cost-row\"><span>Stock actual</span><span class=\"fw7 text-gold\" id=\"me-stock-actual\">—</span></div>\n    </div>\n    <div class=\"fr\">\n      <div><label>Tipo</label><select id=\"me-tipo\"><option value=\"entrada\">Entrada (compra)</option><option value=\"salida\">Salida (uso/merma)</option></select></div>\n      <div><label>Cantidad (unidades)</label><input id=\"me-cantidad\" type=\"number\" min=\"0\" placeholder=\"0\"></div>\n    </div>\n    <div class=\"fr fr1\"><div><label>Nota</label><input id=\"me-nota\" placeholder=\"Ej: Compra proveedor\"></div></div>\n    <button class=\"btn btn-gold btn-full mb-16\" onclick=\"guardarMovEnvase()\">Registrar movimiento</button>\n    <h3>Historial</h3>\n    <div id=\"me-historial\"></div>\n  </div>\n</div>\n\n<script src=\"js/db.js\"></script>\n<script src=\"js/github-sync.js\"></script>\n<script src=\"js/modules1.js\"></script>\n<script src=\"js/modules2.js\"></script>\n<script>\n  // Mostrar/ocultar btn admin en envases\n  var _origGoPage = goPage;\n  goPage = function(name, btn) {\n    _origGoPage(name, btn);\n    var bEnv = document.getElementById('btn-new-envase');\n    if(bEnv) bEnv.style.display = (currentUser && currentUser.rol === 'admin' && name === 'envases') ? '' : 'none';\n  };\n\n  function updateSyncUI(status, detail) {\n    const dot = document.getElementById('sync-dot');\n    const txt = document.getElementById('sync-text');\n    if (!dot || !txt) return;\n    if (status === 'syncing') { dot.style.background = '#c9963a'; txt.textContent = 'Sync...'; }\n    else if (status === 'ok') { dot.style.background = '#4caf50'; txt.textContent = detail || 'OK'; }\n    else if (status === 'error') { dot.style.background = '#e07070'; txt.textContent = detail || 'Err'; }\n    else { dot.style.background = '#666'; txt.textContent = '—'; }\n  }\n\n  function forceSyncNow() {\n    if (typeof ghPull === 'function' && getGhConfig()) {\n      updateSyncUI('syncing');\n      ghPull().then(updated => {\n        if (updated) { refreshCurrentPage(); updateSyncUI('ok', 'Ahora'); if(currentUser) toast('Datos sincronizados'); }\n        else updateSyncUI('ok', 'Sin cambios');\n      }).catch(err => { updateSyncUI('error', 'Fail'); toast('Error: '+err.message, 'err'); });\n    } else { toast('Sync no configurado', 'err'); }\n  }\n\n  // Service Worker registration\n  if ('serviceWorker' in navigator) {\n    navigator.serviceWorker.register('sw.js').then(function(reg) {\n      reg.addEventListener('updatefound', function() {\n        var newWorker = reg.installing;\n        newWorker.addEventListener('statechange', function() {\n          if (newWorker.state === 'activated' && !sessionStorage.getItem('_sw_reloaded')) {\n            sessionStorage.setItem('_sw_reloaded', '1');\n            window.location.reload();\n          }\n        });\n      });\n    }).catch(function(err) {\n      console.warn('[Arcano] SW registro fallo:', err);\n    });\n  }\n\n  async function bootApp() {\n    console.log('[Arcano] v18 - arcano-v2 fresh start');\n    await initGithubSync();\n    seedIfEmpty();\n    if (typeof applyPWAConfig === 'function') applyPWAConfig(getPWAConfig());\n    initPin();\n    renderGhAjustes();\n  }\n  bootApp();\n</script>\n\n</body></html>",
