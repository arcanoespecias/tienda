    "html": "<html lang=\"es\" style=\"--bg: #1b0b07; --bg2: #221108; --surface: #2a150e; --surface2: #331e12; --gold: #c9963a; --gold2: #e8b84b; --cream: #f0e8d0; --muted: #7a6a50; --fs-base: 15px; --fs-title: 1.9rem;\"><head>\n<meta charset=\"UTF-8\">\n<meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n<meta http-equiv=\"Pragma\" content=\"no-cache\">\n<meta http-equiv=\"Expires\" content=\"0\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#1b0b07\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Arcano\">\n<link rel=\"icon\" type=\"image/png\" href=\"icons/favicon.png?v=17\">\n<link rel=\"apple-touch-icon\" href=\"icons/icon-192.png?v=17\">\n<title>Arcano — Complice del Sabor</title>\n<link rel=\"manifest\" href=\"manifest.json?v=17\">\n<link rel=\"stylesheet\" href=\"css/style.css?v=17\">\n</head>\n<body style=\"background: rgb(27, 11, 7); font-size: 15px;\">\n\n<div id=\"pin-screen\" style=\"display:flex\"><div style=\"text-align:center\"><img src=\"icons/logo-pin.png?v=17\" style=\"width:80px;height:80px;margin-bottom:4px;object-fit:contain\"><div class=\"pin-logo\">Arcano</div><div class=\"pin-sub\">Complice del Sabor</div></div><div class=\"user-list\" style=\"margin-top:8px\"><button class=\"user-btn\" onclick=\"selectUser(1)\"><div class=\"user-avatar\">👑</div><div><div style=\"font-size:.95rem;font-weight:700\">Admin</div><div style=\"font-size:.7rem;color:var(--muted)\">admin</div></div></button><button class=\"user-btn\" onclick=\"selectUser(2)\"><div class=\"user-avatar\">🌿</div><div><div style=\"font-size:.95rem;font-weight:700\">Operador</div><div style=\"font-size:.7rem;color:var(--muted)\">operador</div></div></button></div></div>\n\n<!-- PWA INSTALL BANNER -->\n<div id=\"pwa-banner\" style=\"display:none\">\n  <div class=\"pwa-banner-inner\">\n    <img src=\"icons/icon-192.png?v=17\" alt=\"\" style=\"width:40px;height:40px;border-radius:8px\">\n    <div class=\"pwa-banner-text\"><div class=\"fw7 text-sm\">Instalar Arcano</div><div class=\"text-xs text-muted\">Acceso rapido desde tu pantalla de inicio</div></div>\n    <button class=\"btn btn-gold btn-sm\" onclick=\"installPWA()\">Instalar</button>\n    <button class=\"btn btn-ghost btn-sm\" onclick=\"dismissPWA()\" style=\"padding:5px 8px;font-size:.9rem\">x</button>\n  </div>\n</div>\n\n<div id=\"toast\"></div>\n\n<!-- HEADER -->\n<div id=\"app-header\">\n  <div class=\"header-logo\">\n    <img src=\"icons/logo-header.png?v=17\" alt=\"Arcano\" style=\"width:34px;height:34px;border-radius:50%;object-fit:cover\">\n    <div><div class=\"header-brand\">Arcano</div><div class=\"header-sub\">Gestion de especias y blends para Arcano</div></div>\n  </div>\n  <div class=\"header-pin\">\n    <div id=\"sync-indicator\" onclick=\"forceSyncNow()\" title=\"Forzar sync\" style=\"cursor:pointer;font-size:.7rem;margin-right:8px;display:flex;align-items:center;gap:4px\">\n      <span id=\"sync-dot\" style=\"width:8px;height:8px;border-radius:50%;background:#666;display:inline-block\"></span>\n      <span id=\"sync-text\" style=\"color:var(--muted);font-size:.6rem\">—</span>\n    </div>\n    <div class=\"user-chip\" id=\"user-chip\" onclick=\"logoutUser()\">— Salir</div>\n  </div>\n</div>\n\n<!-- NAV -->\n<nav id=\"app-nav\">\n  <button class=\"nav-btn active\" onclick=\"goPage('dashboard',this)\">Dashboard</button>\n  <button class=\"nav-btn\" onclick=\"goPage('costos',this)\">Costos</button>\n  <button class=\"nav-btn\" onclick=\"goPage('productos',this)\">Productos</button>\n  <button class=\"nav-btn\" onclick=\"goPage('envases',this)\">Envases</button>\n  <button class=\"nav-btn\" onclick=\"goPage('blends',this)\">Blends</button>\n  <button class=\"nav-btn\" onclick=\"goPage('ventas',this)\">Ventas</button>\n  <button class=\"nav-btn\" onclick=\"goPage('reportes',this)\">Reportes</button>\n  <button class=\"nav-btn\" id=\"nav-ajustes\" onclick=\"goPage('ajustes',this)\">⚙ Ajustes</button>\n</nav>\n\n<main>\n\n<!-- DASHBOARD -->\n<div id=\"page-dashboard\" class=\"page active\">\n  <div class=\"page-title\">Dashboard</div>\n  <div class=\"g4 mb-20\" id=\"dash-stats\"></div>\n  <div class=\"g2 mb-20\">\n    <div class=\"card\"><h3>Ventas ultimos 7 dias</h3><div class=\"bar-chart\" id=\"chart-7d\"></div></div>\n    <div class=\"card\"><h3>Stock bajo — alerta</h3><div id=\"dash-stock-bajo\"></div></div>\n  </div>\n  <div class=\"g2\">\n    <div class=\"card\"><h3>Ultimas ventas</h3><div class=\"tw\"><table><thead><tr><th>Fecha</th><th>Productos</th><th>Total</th><th>Estado</th></tr></thead><tbody id=\"dash-ventas-tabla\"></tbody></table></div></div>\n    <div class=\"card\"><h3>Productos mas vendidos</h3><div id=\"dash-top\"></div></div>\n  </div>\n</div>\n\n<!-- COSTOS -->\n<div id=\"page-costos\" class=\"page\">\n  <div class=\"page-title\">Costos</div>\n  <div class=\"g2 mb-20\">\n    <div class=\"card\"><h3>Envases</h3><div class=\"fr\"><div><label>Envase Chico ($/u)</label><input type=\"number\" id=\"c-env-c\" oninput=\"saveCostos()\"></div><div><label>Envase Grande ($/u)</label><input type=\"number\" id=\"c-env-g\" oninput=\"saveCostos()\"></div></div></div>\n    <div class=\"card\"><h3>Packaging</h3><div class=\"fr\"><div><label>Packaging Chico</label><input type=\"number\" id=\"c-pkg-c\" oninput=\"saveCostos()\"></div><div><label>Packaging Grande</label><input type=\"number\" id=\"c-pkg-g\" oninput=\"saveCostos()\"></div></div></div>\n  </div>\n  <div class=\"card mb-20\"><h3>Otros costos fijos por unidad</h3><div class=\"fr3\"><div><label>Etiqueta</label><input type=\"number\" id=\"c-etiq\" oninput=\"saveCostos()\"></div><div><label>Mano de obra</label><input type=\"number\" id=\"c-mo\" oninput=\"saveCostos()\"></div><div><label>Otros</label><input type=\"number\" id=\"c-otros\" oninput=\"saveCostos()\"></div></div></div>\n  <div class=\"card\"><h3>Resumen de costos fijos por unidad</h3><div class=\"g2 mt-12\" id=\"resumen-costos\"></div></div>\n</div>\n\n<!-- PRODUCTOS -->\n<div id=\"page-productos\" class=\"page\">\n  <div id=\"lista-productos\"></div>\n</div>\n\n<!-- ENVASES -->\n<div id=\"page-envases\" class=\"page\">\n  <div class=\"flex items-center justify-between mb-20\">\n    <div class=\"page-title\" style=\"margin:0\">Envases</div>\n    <button class=\"btn btn-gold\" id=\"btn-new-envase\" onclick=\"openModalEnvase()\" style=\"display:none\">+ Nuevo envase</button>\n  </div>\n  <div id=\"lista-envases\"></div>\n</div>\n\n<!-- BLENDS -->\n<div id=\"page-blends\" class=\"page\">\n  <div class=\"flex items-center justify-between mb-20\">\n    <div class=\"page-title\" style=\"margin:0\">Blends</div>\n    <div class=\"flex gap-8\">\n      <button class=\"btn btn-ghost btn-sm\" id=\"btn-export-blends\" onclick=\"exportBlendsExcel()\" style=\"display:none\">📥 Exportar Excel</button>\n      <button class=\"btn btn-gold\" onclick=\"openModalBlend()\">+ Nuevo blend</button>\n    </div>\n  </div>\n  <div id=\"lista-blends\"></div>\n</div>\n\n<!-- VENTAS -->\n<div id=\"page-ventas\" class=\"page\">\n  <div class=\"flex items-center justify-between mb-20\">\n    <div class=\"page-title\" style=\"margin:0\">Ventas</div>\n    <button class=\"btn btn-gold\" onclick=\"openModalVenta()\">+ Nueva venta</button>\n  </div>\n  <div class=\"flex gap-8 mb-16\" style=\"flex-wrap:wrap\">\n    <div class=\"search-wrap\" style=\"flex:1;min-width:200px;margin-bottom:0\"><input id=\"search-ventas\" placeholder=\"Buscar...\" oninput=\"renderVentas()\"></div>\n    <select id=\"filter-estado\" onchange=\"renderVentas()\" style=\"width:auto\"><option value=\"\">Todos</option><option value=\"completada\">Completada</option><option value=\"pendiente\">Pendiente</option><option value=\"entregada\">Entregada</option><option value=\"cancelada\">Cancelada</option></select>\n  </div>\n  <div class=\"card\"><div class=\"tw\"><table><thead><tr><th>Fecha</th><th>Productos</th><th>Subtotal</th><th>Desc.</th><th>Total</th><th>Estado</th><th></th></tr></thead><tbody id=\"tabla-ventas\"></tbody></table></div></div>\n</div>\n\n<!-- REPORTES -->\n<div id=\"page-reportes\" class=\"page\">\n  <div class=\"page-title\">Reportes</div>\n  <div class=\"g3 mb-20\" id=\"rep-stats\"></div>\n  <div class=\"tabs\"><button class=\"tab active\" onclick=\"showTab('rep-mes')\">Por mes</button><button class=\"tab\" onclick=\"showTab('rep-prod')\">Por producto</button><button class=\"tab\" onclick=\"showTab('rep-rent')\">Rentabilidad</button></div>\n  <div id=\"rep-mes\" class=\"card\"><h3>Ventas por mes</h3><div class=\"tw\"><table><thead><tr><th>Mes</th><th>Ventas</th><th>Ingresos</th><th>Prom./venta</th></tr></thead><tbody id=\"rep-mes-tabla\"></tbody></table></div></div>\n  <div id=\"rep-prod\" class=\"card\" style=\"display:none\"><h3>Por producto</h3><div class=\"tw\"><table><thead><tr><th>Producto</th><th>Unidades</th><th>Ingresos</th><th>%</th></tr></thead><tbody id=\"rep-prod-tabla\"></tbody></table></div></div>\n  <div id=\"rep-rent\" class=\"card\" style=\"display:none\"><h3>Rentabilidad</h3><div class=\"tw\"><table><thead><tr><th>Blend</th><th>Costo/kg</th><th>Chico</th><th>Grande</th></tr></thead><tbody id=\"rep-rent-tabla\"></tbody></table></div></div>\n</div>\n\n<!-- AJUSTES -->\n<div id=\"page-ajustes\" class=\"page\">\n  <div class=\"page-title\">Ajustes</div>\n  <!-- PWA CONFIG -->\n  <div class=\"card mb-20\">\n    <div class=\"flex items-center justify-between mb-16\"><h3 style=\"margin:0\">Apariencia y PWA</h3><div class=\"flex gap-8\"><span id=\"pwa-status-badge\" class=\"badge by\">—</span><button class=\"btn btn-gold btn-sm\" id=\"pwa-install-btn-settings\" onclick=\"installPWA()\" style=\"display:none\">Instalar app</button></div></div>\n    <div class=\"section-title mb-12\">Identidad</div>\n    <div class=\"g2 mb-16\"><div><label>Nombre</label><input id=\"pwa-cfg-name\" oninput=\"previewPWA()\"></div><div><label>Nombre corto</label><input id=\"pwa-cfg-short\" oninput=\"previewPWA()\"></div></div>\n    <div class=\"g2 mb-16\"><div><label>Descripcion</label><input id=\"pwa-cfg-desc\"></div><div><label>Orientacion</label><select id=\"pwa-cfg-orient\"><option value=\"portrait-primary\">Vertical</option><option value=\"landscape-primary\">Horizontal</option><option value=\"any\">Libre</option></select></div></div>\n    <hr class=\"divider\">\n    <div class=\"section-title mb-12\">Colores</div>\n    <div class=\"g2 mb-12\"><div><label>Fondo</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-bg\" type=\"color\" value=\"#1b0b07\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-bg-text\" value=\"#1b0b07\" maxlength=\"7\" oninput=\"syncColorInput('bg')\" style=\"flex:1\"></div></div><div><label>Header / nav</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-bg2\" type=\"color\" value=\"#221108\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-bg2-text\" value=\"#221108\" maxlength=\"7\" oninput=\"syncColorInput('bg2')\" style=\"flex:1\"></div></div></div>\n    <div class=\"g2 mb-12\"><div><label>Tarjetas</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-surface\" type=\"color\" value=\"#2a150e\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-surface-text\" value=\"#2a150e\" maxlength=\"7\" oninput=\"syncColorInput('surface')\" style=\"flex:1\"></div></div><div><label>Inputs</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-surface2\" type=\"color\" value=\"#331e12\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-surface2-text\" value=\"#331e12\" maxlength=\"7\" oninput=\"syncColorInput('surface2')\" style=\"flex:1\"></div></div></div>\n    <div class=\"g2 mb-12\"><div><label>Accent dorado</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-gold\" type=\"color\" value=\"#c9963a\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-gold-text\" value=\"#c9963a\" maxlength=\"7\" oninput=\"syncColorInput('gold')\" style=\"flex:1\"></div></div><div><label>Accent claro</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-gold2\" type=\"color\" value=\"#e8b84b\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-gold2-text\" value=\"#e8b84b\" maxlength=\"7\" oninput=\"syncColorInput('gold2')\" style=\"flex:1\"></div></div></div>\n    <div class=\"g2 mb-16\"><div><label>Texto principal</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-cream\" type=\"color\" value=\"#f0e8d0\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-cream-text\" value=\"#f0e8d0\" maxlength=\"7\" oninput=\"syncColorInput('cream')\" style=\"flex:1\"></div></div><div><label>Texto secundario</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-muted\" type=\"color\" value=\"#7a6a50\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-muted-text\" value=\"#7a6a50\" maxlength=\"7\" oninput=\"syncColorInput('muted')\" style=\"flex:1\"></div></div></div>\n    <div class=\"mb-16\"><label>Color tema (barra celular)</label><div class=\"flex gap-8\"><input id=\"pwa-cfg-theme\" type=\"color\" value=\"#1b0b07\" style=\"width:44px;height:36px;padding:2px;cursor:pointer\" oninput=\"previewPWA()\"><input id=\"pwa-cfg-theme-text\" value=\"#1b0b07\" maxlength=\"7\" oninput=\"syncColorInput('theme')\" style=\"flex:1\"></div></div>\n    <hr class=\"divider\">\n    <div class=\"section-title mb-12\">Tipografia</div>\n    <div class=\"g2 mb-16\"><div><label>Tamano base <span id=\"pwa-cfg-fs-base-val\" class=\"text-gold\">15px</span></label><input id=\"pwa-cfg-fs-base\" type=\"range\" min=\"11\" max=\"20\" step=\"1\" value=\"15\" oninput=\"previewPWA()\"></div><div><label>Tamano titulos <span id=\"pwa-cfg-fs-title-val\" class=\"text-gold\">1.9rem</span></label><input id=\"pwa-cfg-fs-title\" type=\"range\" min=\"1.0\" max=\"3.0\" step=\"0.1\" value=\"1.9\" oninput=\"previewPWA()\"></div></div>\n    <hr class=\"divider\">\n    <div class=\"cost-box mb-16\" id=\"pwa-preview-box\"><div class=\"text-xs text-muted mb-12\">Vista previa</div><div class=\"flex items-center gap-8\"><img src=\"icons/icon-192.png?v=17\" style=\"width:36px;height:36px;border-radius:8px\"><div><div class=\"fw7 text-sm\" id=\"pwa-preview-name\">Arcano</div><div class=\"text-xs text-muted\" id=\"pwa-preview-desc\">Complice del Sabor</div></div></div></div>\n    <div class=\"flex gap-8\"><button class=\"btn btn-gold\" style=\"flex:1\" onclick=\"guardarPWAConfig()\">Guardar</button><button class=\"btn btn-ghost\" style=\"flex:1\" onclick=\"resetPWAConfig()\">Restaurar</button></div>\n  </div>\n  <div class=\"g2\">\n    <div class=\"card\"><div class=\"flex items-center justify-between mb-16\"><h3 style=\"margin:0\">Usuarios</h3><button class=\"btn btn-gold btn-sm\" onclick=\"openModalUsuario()\">+ Nuevo</button></div><div id=\"ajustes-usuarios\"></div></div>\n    <div>\n      <div class=\"card mb-16\"><div class=\"flex items-center justify-between mb-16\"><h3 style=\"margin:0\">Sincronizacion GitHub</h3><span id=\"gh-status-badge\" class=\"badge br\">Desconectado</span></div><p class=\"text-muted text-sm mb-16\">Datos guardados en JSON del repo. Sync automatico entre usuarios.</p><div id=\"gh-config-form\" style=\"display: block;\"><div class=\"fr fr1\"><div><label>Personal Access Token</label><input id=\"gh-token\" type=\"password\" placeholder=\"ghp_xxxx...\"></div></div><div class=\"flex gap-8 mt-16\"><button class=\"btn btn-gold\" style=\"flex:1\" onclick=\"guardarGhConfigUI()\">Conectar</button></div></div><div id=\"gh-connected-info\" style=\"display:none\"><div class=\"cost-box mb-16\"><div class=\"cost-row\"><span>Repositorio</span><span id=\"gh-info-repo\" class=\"text-gold fw7\"></span></div><div class=\"cost-row\"><span>Branch</span><span id=\"gh-info-branch\"></span></div><div class=\"cost-row\"><span>Estado</span><span class=\"text-green fw7\">Sincronizando</span></div></div><div class=\"cost-box mb-16\" style=\"border-color:var(--gold-dim)\"><p class=\"text-sm text-muted mb-12\" style=\"margin:0\">Link para compartir:</p><div class=\"flex gap-8 mt-8\"><input id=\"gh-share-link\" readonly=\"\" style=\"font-size:.75rem;opacity:.7\" onclick=\"this.select()\"><button class=\"btn btn-gold btn-sm\" onclick=\"copiarLinkConexion()\">Copiar</button></div></div><div class=\"flex gap-8\"><button class=\"btn btn-ghost\" style=\"flex:1\" onclick=\"forzarSyncManual()\">Forzar sync</button><button class=\"btn btn-red\" onclick=\"desconectarGh()\">Desconectar</button></div><div style=\"margin-top:12px\"><button class=\"btn btn-gold btn-full\" onclick=\"forceReloadAllDevices()\" style=\"background:linear-gradient(135deg,#2a7a3a,#4caf50)\">Forzar actualizacion en todos los dispositivos</button><p class=\"text-muted text-xs mt-8\" style=\"margin:0\">Borra cache y recarga la app en todos los celulares/tablets conectados.</p></div></div></div>\n      <div class=\"card\"><h3>Zona de peligro</h3><p class=\"text-muted text-sm mb-16\">Borra todos los datos localmente.</p><button class=\"btn btn-red\" onclick=\"borrarTodo()\">Borrar todo</button></div>\n    </div>\n  </div>\n</div>\n\n</main>\n\n<!-- MODAL ESPECIA -->\n<div class=\"modal-overlay\" id=\"modal-esp\"><div class=\"modal\"><div class=\"modal-header\"><span class=\"modal-title\" id=\"modal-esp-titulo\">Nueva especia</span><button class=\"modal-close\" onclick=\"closeModal('modal-esp')\">x</button></div><div id=\"alert-esp\" class=\"alert\"></div><div class=\"fr fr1\"><div><label>Nombre *</label><input id=\"esp-nombre\" placeholder=\"Ej: Comino\"></div></div><div class=\"fr\"><div><label>Precio por kg ($) *</label><input id=\"esp-precio\" type=\"number\" min=\"0\" oninput=\"calcEsp100()\"></div><div><label>Precio por 100g</label><input id=\"esp-100\" readonly=\"\"></div></div><div class=\"fr\"><div><label>Stock (g)</label><input id=\"esp-stock\" type=\"number\" min=\"0\" value=\"0\"></div><div><label>Stock minimo (g)</label><input id=\"esp-stockmin\" type=\"number\" min=\"0\" value=\"500\"></div></div><button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarEspecia()\">Guardar</button></div></div>\n\n<!-- MODAL STOCK -->\n<div class=\"modal-overlay\" id=\"modal-stock\"><div class=\"modal\"><div class=\"modal-header\"><span class=\"modal-title\" id=\"ms-nombre\">Stock</span><button class=\"modal-close\" onclick=\"closeModal('modal-stock')\">x</button></div><div id=\"alert-stock\" class=\"alert\"></div><input type=\"hidden\" id=\"ms-esp-id\"><div class=\"cost-box mb-16\"><div class=\"cost-row\"><span>Stock actual</span><span class=\"fw7 text-gold\" id=\"ms-stock-actual\">—</span></div></div><div class=\"fr\"><div><label>Tipo</label><select id=\"ms-tipo\"><option value=\"entrada\">Entrada (compra)</option><option value=\"salida\">Salida (uso/merma)</option></select></div><div><label>Cantidad (g)</label><input id=\"ms-cantidad\" type=\"number\" min=\"0\" placeholder=\"0\"></div></div><div class=\"fr fr1\"><div><label>Nota</label><input id=\"ms-nota-stock\" placeholder=\"Ej: Compra proveedor\"></div></div><button class=\"btn btn-gold btn-full mb-16\" onclick=\"guardarMovimiento()\">Registrar</button><h3>Historial</h3><div id=\"ms-historial\"></div></div></div>\n\n<!-- MODAL BLEND -->\n<div class=\"modal-overlay\" id=\"modal-blend\"><div class=\"modal\" style=\"max-width:620px\"><div class=\"modal-header\"><span class=\"modal-title\" id=\"modal-blend-titulo\">Nuevo Blend</span><button class=\"modal-close\" onclick=\"closeModal('modal-blend')\">x</button></div><div id=\"alert-blend\" class=\"alert\"></div><div class=\"fr fr1\"><div><label>Nombre *</label><input id=\"bl-nombre\" placeholder=\"Ej: Garam Masala\"></div></div><div class=\"fr\"><div><label>Peso chico (g)</label><input id=\"bl-peso-c\" type=\"number\" min=\"0\" oninput=\"calcBlendModal()\"></div><div><label>Peso grande (g)</label><input id=\"bl-peso-g\" type=\"number\" min=\"0\" oninput=\"calcBlendModal()\"></div></div><div class=\"fr\"><div><label>Precio chico ($)</label><input id=\"bl-pventa-c\" type=\"number\" min=\"0\"></div><div><label>Precio grande ($)</label><input id=\"bl-pventa-g\" type=\"number\" min=\"0\"></div></div><div class=\"fr fr1\"><div><label>Notas</label><textarea id=\"bl-notas\" placeholder=\"Instrucciones...\"></textarea></div></div><hr class=\"divider\"><h3>Ingredientes — formula /1kg</h3><div id=\"blend-ings-rows\"></div><button class=\"btn btn-ghost btn-sm mt-12\" onclick=\"addIngRow()\">+ Agregar especia</button><div class=\"cost-box mt-16\"><div class=\"fr\" style=\"margin-bottom:0\"><div><div class=\"cost-row\"><span>Costo /kg</span><span id=\"bc-kg\">$0</span></div><div class=\"cost-row\"><span>Costo /100g</span><span id=\"bc-100\">$0</span></div><div class=\"text-xs mt-12\" id=\"bc-grams\" style=\"text-align:center\"></div></div><div><div class=\"cost-row total\"><span>Total u. chica</span><span id=\"bc-tot-c\">$0</span></div><div class=\"cost-row text-xs\"><span class=\"text-muted\">MP</span><span id=\"bc-mp-c\">$0</span></div><div class=\"cost-row text-xs\"><span class=\"text-muted\">Fijos</span><span id=\"bc-fij-c\">$0</span></div><div class=\"cost-row total\" style=\"margin-top:8px\"><span>Total u. grande</span><span id=\"bc-tot-g\">$0</span></div><div class=\"cost-row text-xs\"><span class=\"text-muted\">MP</span><span id=\"bc-mp-g\">$0</span></div><div class=\"cost-row text-xs\"><span class=\"text-muted\">Fijos</span><span id=\"bc-fij-g\">$0</span></div></div></div><button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarBlend()\">Guardar blend</button></div></div>\n\n<!-- MODAL