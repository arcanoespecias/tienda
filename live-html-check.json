 id=\"usr-emoji\" placeholder=\"🌶\" maxlength=\"2\"></div></div><div class=\"fr\"><div><label>PIN (min 4) *</label><input id=\"usr-pin\" type=\"password\" maxlength=\"8\" placeholder=\"....\"></div><div><label>Rol</label><select id=\"usr-rol\"><option value=\"admin\">Admin</option><option value=\"operador\">Operador</option></select></div></div><button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarUsuario()\">Guardar usuario</button></div></div>\n\n<!-- MODAL ENVASE -->\n<div class=\"modal-overlay\" id=\"modal-env\"><div class=\"modal\"><div class=\"modal-header\"><span class=\"modal-title\" id=\"modal-env-titulo\">Nuevo envase</span><button class=\"modal-close\" onclick=\"closeModal('modal-env')\">x</button></div><div id=\"alert-env\" class=\"alert\"></div><div class=\"fr fr1\"><div><label>Nombre *</label><input id=\"env-nombre\" placeholder=\"Ej: Frasco 100ml\"></div></div><div class=\"fr\"><div><label>Tipo</label><select id=\"env-tipo\"><option value=\"chico\">Pequeno</option><option value=\"grande\">Grande</option></select></div><div><label>Peso (g)</label><input id=\"env-peso\" type=\"number\" min=\"0\"></div></div><div class=\"fr\"><div><label>Stock (unidades)</label><input id=\"env-stock\" type=\"number\" min=\"0\" value=\"0\"></div><div><label>Stock minimo</label><input id=\"env-stockmin\" type=\"number\" min=\"0\" value=\"20\"></div></div><div class=\"fr fr1\"><div><label>Precio ($/u)</label><input id=\"env-precio\" type=\"number\" min=\"0\" value=\"0\"></div></div><button class=\"btn btn-gold btn-full mt-16\" onclick=\"guardarEnvase()\">Guardar envase</button></div></div>\n\n<!-- MODAL STOCK ENVASE -->\n<div class=\"modal-overlay\" id=\"modal-env-stock\"><div class=\"modal\"><div class=\"modal-header\"><span class=\"modal-title\" id=\"me-nombre\">Stock envase</span><button class=\"modal-close\" onclick=\"closeModal('modal-env-stock')\">x</button></div><div id=\"alert-env-stock\" class=\"alert\"></div><input type=\"hidden\" id=\"me-env-id\"><div class=\"cost-box mb-16\"><div class=\"cost-row\"><span>Stock actual</span><span class=\"fw7 text-gold\" id=\"me-stock-actual\">—</span></div></div><div class=\"fr\"><div><label>Tipo</label><select id=\"me-tipo\"><option value=\"entrada\">Entrada (compra)</option><option value=\"salida\">Salida (uso/merma)</option></select></div><div><label>Cantidad (unidades)</label><input id=\"me-cantidad\" type=\"number\" min=\"0\" placeholder=\"0\"></div></div><div class=\"fr fr1\"><div><label>Nota</label><input id=\"me-nota\" placeholder=\"Ej: Compra proveedor\"></div></div><button class=\"btn btn-gold btn-full mb-16\" onclick=\"guardarMovEnvase()\">Registrar movimiento</button><h3>Historial</h3><div id=\"me-historial\"></div></div></div>\n\n<script src=\"js/db.js?v=17\"></script>\n<script src=\"js/github-sync.js?v=17\"></script>\n<script src=\"js/modules1.js?v=17\"></script>\n<script src=\"js/modules2.js?v=17\"></script>\n<script>\n  function updateSyncUI(status, detail) {\n    var dot=document.getElementById('sync-dot'),txt=document.getElementById('sync-text');\n    if(!dot||!txt)return;\n    if(status==='syncing'){dot.style.background='#c9963a';txt.textContent='Sync...';}\n    else if(status==='ok'){dot.style.background='#4caf50';txt.textContent=detail||'OK';}\n    else if(status==='error'){dot.style.background='#e07070';txt.textContent=detail||'Err';}\n    else{dot.style.background='#666';txt.textContent='—';}\n  }\n  function forceSyncNow(){\n    if(typeof ghPull==='function'&&getGhConfig()){updateSyncUI('syncing');ghPull().then(function(u){if(u){refreshCurrentPage();updateSyncUI('ok','Ahora');if(currentUser)toast('Sync OK');}else updateSyncUI('ok','Sin cambios');}).catch(function(e){updateSyncUI('error','Fail');toast('Error: '+e.message,'err');});}else{toast('Sync no configurado','err');}\n  }\n  // Mostrar/ocultar btn admin en envases\n  var _origGoPage = goPage;\n  goPage = function(name, btn) {\n    _origGoPage(name, btn);\n    var bEnv = document.getElementById('btn-new-envase');\n    if(bEnv) bEnv.style.display = (currentUser && currentUser.rol === 'admin' && name === 'envases') ? '' : 'none';\n  };\n\n  // GitHub defaults — used by guardarGhConfigUI() in modules2.js\n  var GH_DEFAULT = { owner: 'arcanoespecias', repo: 'arcano-app', branch: 'main' };\n\n  // ===================== SERVICE WORKER =====================\n  // Registro estable (sin timestamp) para que el browser detecte cambios de contenido\n  if ('serviceWorker' in navigator) {\n    navigator.serviceWorker.register('sw.js').then(function(reg) {\n      console.log('[Arcano] SW registrado');\n      // Cuando se detecte nueva version del SW, recargar UNA sola vez\n      reg.addEventListener('updatefound', function() {\n        var newWorker = reg.installing;\n        newWorker.addEventListener('statechange', function() {\n          if (newWorker.state === 'activated' && !sessionStorage.getItem('_sw_reloaded')) {\n            sessionStorage.setItem('_sw_reloaded', '1');\n            console.log('[Arcano] Nueva version del SW activada, recargando...');\n            window.location.reload();\n          }\n        });\n      });\n    }).catch(function(err) {\n      console.warn('[Arcano] SW registro fallo:', err);\n    });\n  }\n\n  async function bootApp() {\n    console.log('[Arcano] v17 - SW cache control + force reload');\n    // Version check: force reload if old version cached\n    var storedVer = localStorage.getItem('arcano_app_version');\n    if (storedVer && storedVer !== APP_VERSION) {\n      console.log('[Arcano] Version change detected: ' + storedVer + ' → ' + APP_VERSION + ', reloading...');\n      localStorage.setItem('arcano_app_version', APP_VERSION);\n      window.location.reload(true);\n      return;\n    }\n    localStorage.setItem('arcano_app_version', APP_VERSION);\n\n    await initGithubSync();\n    seedIfEmpty();\n    if (typeof applyPWAConfig === 'function') applyPWAConfig(getPWAConfig());\n    initPin();\n    renderGhAjustes();\n  }\n  bootApp();\n</script>\n\n</div></body></html>",
